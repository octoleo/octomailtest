# Required connection details.
HOST=mx1.email.host
EMAIL=your@email.com
PASS="secret"

# Optional: defaults to the domain after @ in EMAIL.
# DOMAIN=email.com

# Optional: all standard ports below are tested without overrides.
SMTP_RELAY_PORT=25
SMTP_PORT=587
SMTPS_PORT=465
IMAP_PORT=143
IMAPS_PORT=993
SIEVE_PORT=4190
